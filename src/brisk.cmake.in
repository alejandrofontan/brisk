FIND_LIBRARY(brisk_LIBRARY brisk
    PATHS "@CMAKE_INSTALL_PREFIX@/lib"
)
FIND_PATH(brisk_INCLUDE_DIR brisk.h
    PATHS "@CMAKE_INSTALL_PREFIX@/include/@PROJECT_NAME@" 
)
LIST(APPEND brisk_INCLUDE_DIR ${brisk_INCLUDE_DIR}/../)
SET(brisk_LIBRARIES ${brisk_LIBRARY})
SET(brisk_LIBS ${brisk_LIBRARY})
SET(brisk_INCLUDE_DIRS ${brisk_INCLUDE_DIR})
